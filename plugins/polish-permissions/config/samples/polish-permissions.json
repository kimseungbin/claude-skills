{
  "$comment": "Copy to .claude/config/polish-permissions.json. Extends the built-in lists; it cannot shrink them.",
  "readonlyBash": [
    "mycli show *",
    "mycli status*"
  ],
  "readonlyTools": [
    "mcp__internal__search_docs"
  ],
  "mutatingMarkers": [
    "provision",
    "rotate"
  ],
  "sensitiveReads": [
    "mycli print-token*",
    "cat *company-secrets*"
  ]
}
